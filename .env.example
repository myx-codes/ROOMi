NODE_ENV=development
PORT_API=3008
PORT_BATCH=3006

MONGO_DEV=mongodb://localhost:27017/roomi
MONGO_PROD=mongodb://localhost:27017/roomi

# AI chatbot
AI_PROVIDER=ollama
AI_ENABLED=true
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemma3:1b
AI_API_KEY=

# Ollama-specific aliases
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:1b
OLLAMA_API_KEY=

# Optional OpenAI fallback
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

BATCH_TIMEZONE=Asia/Tashkent
BATCH_DRY_RUN=false
